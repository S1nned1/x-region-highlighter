{
  "manifest_version": 3,
  "name": "X Region Highlighter (US / Non-US / South Asia)",
  "version": "1.0.0",
  "description": "Zero-telemetry local Chrome extension that highlights Non-US and South Asia posts and replies on X using X's built-in Account Location & Connected Via metadata.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "page-script.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-script.js",
        "styles.css"
      ],
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "X Region Highlighter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "minimum_chrome_version": "111"
}
